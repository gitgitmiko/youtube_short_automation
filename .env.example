# 9router (OpenAI-compatible gateway on this host)
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
# Optional model overrides (comma-separated, tried in order)
# LLM_MODELS=gemini-free,openrouter/google/gemma-4-31b-it:free
# LLM_VERIFY_MODELS=openrouter/google/gemma-4-31b-it:free,gemini-free
# Shared secret n8n sends as the X-Token header
SERVICE_TOKEN=
# Bind address: the docker bridge of the n8n network
HOST=172.18.0.1
PORT=8797
# TTS (edge-tts)
# TTS_VOICE=id-ID-GadisNeural
# TTS_RATE=+8%
# TTS_PITCH=+20Hz
# Background pictures via gflow-cli / Google Flow (src/visual.js)
# VISUAL_ENABLED=1
# GFLOW_BIN=../gflow-cli/.venv/bin/gflow
# GFLOW_MODEL=nano2
